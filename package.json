{
  "name": "calendar-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply calendar-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply calendar-hub --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings src/worker-configuration.d.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261101.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "5.9.3",
    "vitest": "~4.1.0",
    "wrangler": "^4.150.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261104.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
