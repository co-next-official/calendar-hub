{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Static UI is served from public/. API and auth routes always hit the Worker first.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/guest/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calendar-hub",
      // Replace with the id printed by `npx wrangler d1 create calendar-hub`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    // Comma-separated Google account emails allowed to sign in. Empty = anyone with a Google account.
    "ALLOWED_EMAILS": ""
  }
  // Secrets (set with `npx wrangler secret put <NAME>`, and in .dev.vars locally):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET
}
