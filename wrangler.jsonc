{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Google Calendar mirrors are refreshed every 30 minutes.
  "triggers": { "crons": ["*/30 * * * *"] },
  // Static UI is served from public/. API and auth routes always hit the Worker first.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/guest/api/*", "/feed/*", "/mcp"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calendar-hub",
      // Replace with the id printed by `npx wrangler d1 create calendar-hub`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  // Abuse protection (per IP for sign-in and guest links, per user/API key for the API).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
    { "name": "GUEST_LIMITER", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "4103", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    // Comma-separated Google account emails allowed to sign in. Empty = anyone with a Google account.
    "ALLOWED_EMAILS": ""
  }
  // Secrets (set with `npx wrangler secret put <NAME>`, and in .dev.vars locally):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET
  //   GOOGLE_TOKEN_KEY (Google Calendar integration; `openssl rand -base64 32`)
}
