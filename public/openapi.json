{
  "openapi": "3.1.0",
  "info": {
    "title": "Calendar Hub API",
    "version": "1.0.0",
    "description": "個人カレンダーの予定を読み書きする API。AI からは API キー（Authorization: Bearer chk_...）で呼ぶ。キーの所有者の予定にしかアクセスできない。読み取り専用キーが既定。キーでの削除は ?confirm=true が必要（ユーザーに確認してから付けること）。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "画面の「AI用APIキー」で発行する chk_ で始まるキー"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "enum": [
              "work",
              "personal",
              "team"
            ]
          },
          "all_day": {
            "type": "boolean"
          },
          "start_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "end_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "start_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "end_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "timezone": {
            "type": "string",
            "description": "IANA タイムゾーン（例 Asia/Tokyo）",
            "default": "Asia/Tokyo"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "participants",
              "group"
            ]
          },
          "busy_only": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "web",
              "api",
              "import"
            ]
          },
          "version": {
            "type": "integer",
            "description": "更新時に送り返す。古いと 409"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "is_owner": {
            "type": "boolean"
          },
          "owner_name": {
            "type": "string"
          },
          "group_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "my_response": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pending",
              "yes",
              "no",
              "maybe",
              null
            ],
            "description": "自分が参加者のときの回答"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "email": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "guest": {
                  "type": "boolean"
                },
                "response": {
                  "type": "string"
                }
              }
            }
          },
          "conflicts": {
            "type": "array",
            "description": "作成・更新時のみ。時間が重なる自分の予定",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "start_at": {
                  "type": "string"
                },
                "end_at": {
                  "type": "string"
                }
              }
            }
          },
          "client_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "description": "他人の予定で busy_only のときは title が「予定あり」になり、notes と participants は空"
      },
      "EventCreate": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "enum": [
              "work",
              "personal",
              "team"
            ]
          },
          "all_day": {
            "type": "boolean"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "終日予定の開始日"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "終日予定の終了日（この日は含まない）。省略時は start_date の翌日"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "description": "時刻付き予定の開始。オフセット必須（例 2026-11-10T10:00:00+09:00）"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "description": "時刻付き予定の終了（含まない）。start_at より後、31日以内"
          },
          "timezone": {
            "type": "string",
            "description": "IANA タイムゾーン（例 Asia/Tokyo）",
            "default": "Asia/Tokyo"
          },
          "client_ref": {
            "type": "string",
            "pattern": "^[w:.-]{1,80}$",
            "description": "外部ツール用の重複防止キー。同じ値で再送すると既存の予定を返す（duplicate: true）"
          }
        },
        "description": "終日なら start_date（と end_date）、時刻付きなら start_at と end_at を送る"
      },
      "EventUpdate": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "enum": [
              "work",
              "personal",
              "team"
            ]
          },
          "all_day": {
            "type": "boolean"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "終日予定の開始日"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "終日予定の終了日（この日は含まない）。省略時は start_date の翌日"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "description": "時刻付き予定の開始。オフセット必須（例 2026-11-10T10:00:00+09:00）"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "description": "時刻付き予定の終了（含まない）。start_at より後、31日以内"
          },
          "timezone": {
            "type": "string",
            "description": "IANA タイムゾーン（例 Asia/Tokyo）",
            "default": "Asia/Tokyo"
          }
        },
        "description": "送ったフィールドだけ変わる"
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "paths": {
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "summary": "ログイン中のユーザー",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "未認証",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "期間内の予定一覧（自分の予定と、共有された予定）",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "この日を含む"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "この日を含まない。from から 400 日以内"
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "タイトルの部分一致"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "条件が不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createEvent",
        "summary": "予定を作成（write スコープ）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "作成した予定",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "入力が不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "スコープ不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getEvent",
        "summary": "予定を取得",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "404": {
            "description": "見つからない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateEvent",
        "summary": "予定を更新（write スコープ）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "404": {
            "description": "見つからない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "version が古い。current を見て再試行",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "current": {
                      "$ref": "#/components/schemas/Event"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteEvent",
        "summary": "予定を削除（write スコープ。API キーでは confirm=true 必須）",
        "parameters": [
          {
            "name": "confirm",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            },
            "description": "ユーザーに確認したうえで付ける"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "見つからない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "428": {
            "description": "confirm=true が必要",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}/response": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "respondToEvent",
        "summary": "共有された予定に回答（参加者のみ）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "response"
                ],
                "properties": {
                  "response": {
                    "type": "string",
                    "enum": [
                      "yes",
                      "no",
                      "maybe"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "403": {
            "description": "参加者ではない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "見つからない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}/ics": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "exportEventIcs",
        "summary": "予定を .ics で取得",
        "responses": {
          "200": {
            "description": "iCalendar",
            "content": {
              "text/calendar": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "見つからない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/groups": {
      "get": {
        "operationId": "listGroups",
        "summary": "参加中のグループ一覧（作成・招待はブラウザからのみ）",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "is_owner": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/availability": {
      "get": {
        "operationId": "findAvailability",
        "summary": "共通の空き時間を探す（自分だけ、または参加中グループの全員）。空いている時間帯だけを返し、誰の予定かや予定の中身は返さない",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "この日から"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "この日の前まで（31日以内）"
          },
          {
            "name": "group_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "省略時は自分の予定だけ"
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 15,
              "maximum": 720,
              "default": 60
            },
            "description": "必要な長さ（分）"
          },
          {
            "name": "day_start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "09:00"
            },
            "description": "各日の探す時間帯の開始"
          },
          {
            "name": "day_end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "21:00"
            },
            "description": "各日の探す時間帯の終了"
          },
          {
            "name": "timezone",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "Asia/Tokyo"
            },
            "description": "時間帯を解釈するタイムゾーン"
          },
          {
            "name": "include_all_day",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            },
            "description": "終日予定も埋まりとして扱う"
          }
        ],
        "responses": {
          "200": {
            "description": "空き時間",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "members": {
                      "type": "integer"
                    },
                    "duration_minutes": {
                      "type": "integer"
                    },
                    "windows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "start_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "end_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "グループが見つからない"
          }
        }
      }
    },
    "/api/events/by-ref": {
      "get": {
        "operationId": "listEventsByRef",
        "summary": "client_ref が prefix で始まる自分の予定（日付に関係なく）",
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "予定",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
